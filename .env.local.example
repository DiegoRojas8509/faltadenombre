# Supabase → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Pestaña "Publishable and secret API keys" → sección "Secret keys" → llave `default`.
# ⚠️ Es secreta y solo vive en el servidor. Nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
